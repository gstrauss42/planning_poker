    async function removeTicketByKey(ticketKey, hasVotes) {
      if (!ticketKey) return;
      const confirmMsg = hasVotes
        ? `Remove ticket ${ticketKey}? Its votes will be discarded.`
        : `Remove ticket ${ticketKey}?`;
      if (!confirm(confirmMsg)) return;

      const endpoint = currentMode === 'async'
        ? '/estimations/async_remove_ticket'
        : '/estimations/remove_ticket';

      try {
        const response = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken },
          body: JSON.stringify({ ticket_id: ticketKey })
        });
        const result = await response.json();
        if (!response.ok) throw new Error(result.error || 'Failed to remove ticket');
        if (result.state) {
          syncState(result.state, currentMode === 'async' ? 'async_ticket_removed' : 'ticket_removed');
        }
        if (currentMode === 'async') {
          if (asyncCurrentIndex >= state.asyncTickets.length) {
            asyncCurrentIndex = Math.max(0, state.asyncTickets.length - 1);
          }
          renderAsyncAll();
        }
      } catch (error) {
        showStatus(error.message, true);
      }
    }

