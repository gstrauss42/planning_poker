    // Enhanced WebSocket subscription with robust error handling
    const cable = createConsumer();
    
    function setupSubscription() {
      if (subscription) {
        subscription.unsubscribe();
      }
      
      // Clear any existing timers
      if (heartbeatInterval) clearInterval(heartbeatInterval);
      if (reconnectTimeout) clearTimeout(reconnectTimeout);
      
      subscription = cable.subscriptions.create(
        { channel: "EstimationChannel" },
        {
          connected() {
            console.log("[WebSocket] Connected");
            state.isConnected = true;
            state.lastHeartbeat = Date.now();
            updateConnectionStatus(true);
            showStatus("Connected");
            
            // Start enhanced heartbeat
            startHeartbeat();
            
            // Start periodic state validation
            startStateValidation();
            
            // Start health checks
            startHealthChecks();
          },
          
          disconnected() {
            console.log("[WebSocket] Disconnected");
            state.isConnected = false;
            updateConnectionStatus(false);
            
            // Clear timers
            if (heartbeatInterval) clearInterval(heartbeatInterval);
            if (stateValidationInterval) clearInterval(stateValidationInterval);
            if (healthCheckInterval) clearInterval(healthCheckInterval);
            
            // Attempt reconnection with exponential backoff
            attemptReconnection();
          },
          
          received(data) {
            console.log("[WebSocket] Received:", data);
            
            try {
              if (data.action === "sync_state" || data.action === "sync_state_retry") {
                // Full state sync with validation (handle both primary and retry)
                if (data.action === "sync_state_retry") {
                  console.log(`[WebSocket] Received retry broadcast for ${data.change_action}`);
                }
                syncState(data.state, data.change_action);
                
              } else if (data.action === "presence_update") {
                // Update presence counts
                state.connectedCount = data.connected_count || 0;
                state.votedCount = data.voted_count || 0;
                updatePresenceBadge();
                
              } else if (data.action === "error") {
                // Handle server-side errors
                console.error(`[WebSocket] Server error: ${data.message}`);
                showStatus(data.message, true, 5000);
                
              } else if (data.action === "state_warning") {
                // Handle state integrity warnings
                console.warn(`[WebSocket] State warning: ${data.issues.join(', ')}`);
                showStatus("State integrity issue detected", true, 5000);
                
              } else {
                console.warn(`[WebSocket] Unknown action: ${data.action}`);
              }
              
            } catch (error) {
              console.error(`[WebSocket] Error processing message: ${error.message}`);
              showStatus("Message processing error", true);
            }
          },
          
          rejected() {
            console.error("[WebSocket] Connection rejected");
            showStatus("Connection rejected. Please refresh.", true, 10000);
          }
        }
      );
    }

    function startHeartbeat() {
      heartbeatInterval = setInterval(() => {
        if (state.isConnected && subscription) {
          try {
            subscription.perform('heartbeat');
            state.lastHeartbeat = Date.now();
          } catch (error) {
            console.error(`[Heartbeat] Error: ${error.message}`);
          }
        }
      }, 30000); // Every 30 seconds (reduced from 10s)
    }

    function startStateValidation() {
      stateValidationInterval = setInterval(() => {
        if (state.isConnected && subscription) {
          try {
            subscription.perform('request_state_sync');
          } catch (error) {
            console.error(`[StateValidation] Error: ${error.message}`);
          }
        }
      }, 120000); // Every 2 minutes (reduced from 30s)
    }

    function startHealthChecks() {
      healthCheckInterval = setInterval(async () => {
        try {
          const response = await fetch('/estimations/health', {
            method: 'GET',
            headers: {
              'X-CSRF-Token': csrfToken
            }
          });
          
          if (response.ok) {
            const health = await response.json();
            if (health.status === 'degraded' || health.status === 'error') {
              console.warn(`[HealthCheck] Session health: ${health.status}`);
              showStatus(`Session health: ${health.status}`, true, 5000);
            }
          }
        } catch (error) {
          console.error(`[HealthCheck] Error: ${error.message}`);
        }
      }, 300000); // Every 5 minutes (reduced from 1 minute)
    }

    function attemptReconnection() {
      if (state.reconnectAttempts >= state.maxReconnectAttempts) {
        console.error("[Reconnection] Max attempts reached");
        showStatus("Connection failed. Please refresh the page.", true, 0);
        return;
      }
      
      state.reconnectAttempts++;
      const delay = Math.min(1000 * Math.pow(2, state.reconnectAttempts - 1), 30000); // Exponential backoff, max 30s
      
      console.log(`[Reconnection] Attempt ${state.reconnectAttempts}/${state.maxReconnectAttempts} in ${delay}ms`);
      updateConnectionStatus(false);
      
      reconnectTimeout = setTimeout(() => {
        setupSubscription();
      }, delay);
    }

    function requestStateSync() {
      if (subscription && state.isConnected) {
        // Rate limiting: prevent rapid sync requests
        const now = Date.now();
        if (state.lastSyncRequest && (now - state.lastSyncRequest) < 2000) {
          console.log("[StateSync] Rate limited - too soon since last request");
          return;
        }
        state.lastSyncRequest = now;
        
        // Track sync request count for debugging
        if (!state.syncRequestCount) state.syncRequestCount = 0;
        state.syncRequestCount++;
        
        // Circuit breaker: if too many sync requests, stop
        if (state.syncRequestCount > 20) {
          console.error(`[StateSync] Circuit breaker triggered - too many sync requests (${state.syncRequestCount})`);
          showStatus("Too many sync requests. Please refresh the page.", true, 10000);
          return;
        }
        
        try {
          console.log(`[StateSync] Requesting state sync... (count: ${state.syncRequestCount})`);
          subscription.perform('request_state_sync');
        } catch (error) {
          console.error(`[StateSync] Error requesting sync: ${error.message}`);
        }
      }
    }

