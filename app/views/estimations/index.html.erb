      <div class="ticket-navigation" id="asyncTicketNavigation" style="display: none;">
        <button id="asyncPrevTicketBtn" class="nav-button" disabled>← Previous</button>
        <span class="ticket-position" id="asyncTicketPosition">0 / 0</span>
        <button id="asyncNextTicketBtn" class="nav-button" disabled>Next →</button>
