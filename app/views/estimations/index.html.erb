    function startRevealHold(e) {
      if (revealBtn.disabled) return;
      e.preventDefault();
      
      // Add holding class to start the CSS animation
      revealBtn.classList.add('holding');
      
      // Set timer to execute reveal after hold duration
      revealHoldTimer = setTimeout(() => {
        revealBtn.classList.remove('holding');
        executeReveal();
      }, HOLD_DURATION);
    }

    function cancelRevealHold() {
      if (revealHoldTimer) {
        clearTimeout(revealHoldTimer);
        revealHoldTimer = null;
      }
      revealBtn.classList.remove('holding');
    }

    // Mouse events
    revealBtn.addEventListener("mousedown", startRevealHold);
    revealBtn.addEventListener("mouseup", cancelRevealHold);
    revealBtn.addEventListener("mouseleave", cancelRevealHold);
    
    // Touch events for mobile
    revealBtn.addEventListener("touchstart", startRevealHold);
    revealBtn.addEventListener("touchend", cancelRevealHold);
    revealBtn.addEventListener("touchcancel", cancelRevealHold);
    
    // Prevent click from firing after hold completes
    revealBtn.addEventListener("click", (e) => {
      e.preventDefault();
    });

    // Hold-to-clear functionality (1 second hold required)
    const clearBtn = document.getElementById("clearBtn");
    let clearHoldTimer = null;

    async function executeClear() {
      if (Object.keys(state.votes).length === 0) {
        return;
      }

      if (!state.isConnected) {
        showStatus("Not connected. Please wait for connection.", true);
        return;
      }

      if (state.pendingOperations.has('clear')) {
        showStatus("Clear already in progress. Please wait.", true);
        return;
      }

      state.pendingOperations.add('clear');

      console.log(`[Clear] Starting clear operation with version ${state.version}`);

      try {
        const response = await fetch("/estimations/clear", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            "X-CSRF-Token": csrfToken
          },
          body: JSON.stringify({
            expected_version: state.version
          })
        });

        console.log(`[Clear] Response status: ${response.status}`);
        const result = await response.json();
        console.log(`[Clear] Response result:`, result);
        
        if (!response.ok) {
          if (result.requires_refresh) {
            console.log(`[Clear] Version conflict detected, refreshing state`);
            showStatus("Session state changed. Refreshing...", true);
            requestStateSync();
          } else {
            throw new Error(result.error || "Failed to clear votes");
          }
        } else {
          console.log(`[Clear] Clear operation successful, new version: ${result.new_version}`);
          showStatus("Votes cleared successfully");
          
          // Force immediate state sync to ensure all clients are updated
          setTimeout(() => {
            console.log(`[Clear] Requesting state sync after clear operation`);
            requestStateSync();
          }, 200);
        }
      } catch (error) {
        console.error(`[Clear] Error: ${error.message}`);
        showStatus(error.message, true);
      } finally {
        state.pendingOperations.delete('clear');
      }
    }

    function startClearHold(e) {
      if (clearBtn.disabled) return;
      e.preventDefault();
      
      clearBtn.classList.add('holding');
      
      clearHoldTimer = setTimeout(() => {
        clearBtn.classList.remove('holding');
        executeClear();
      }, HOLD_DURATION);
    }

    function cancelClearHold() {
      if (clearHoldTimer) {
        clearTimeout(clearHoldTimer);
        clearHoldTimer = null;
      }
      clearBtn.classList.remove('holding');
    }

    // Mouse events
    clearBtn.addEventListener("mousedown", startClearHold);
    clearBtn.addEventListener("mouseup", cancelClearHold);
    clearBtn.addEventListener("mouseleave", cancelClearHold);
    
    // Touch events for mobile
    clearBtn.addEventListener("touchstart", startClearHold);
    clearBtn.addEventListener("touchend", cancelClearHold);
    clearBtn.addEventListener("touchcancel", cancelClearHold);
    
    // Prevent click from firing after hold completes
    clearBtn.addEventListener("click", (e) => {
      e.preventDefault();
    });

    // Initialize application with cleanup
    function init() {
      console.log("[Init] Starting enhanced planning poker application");
      
      // Set up page visibility handling
      document.addEventListener('visibilitychange', () => {
        if (document.hidden) {
          console.log("[Visibility] Page hidden - pausing timers");
          pauseTimers();
        } else {
          console.log("[Visibility] Page visible - resuming timers");
          resumeTimers();
        }
      });
      
      // Set up beforeunload handling
      window.addEventListener('beforeunload', () => {
        console.log("[Cleanup] Page unloading - cleaning up");
        cleanup();
      });
      
      // Tab switching
      document.getElementById('liveTab').addEventListener('click', () => switchTab('live'));
      document.getElementById('asyncTab').addEventListener('click', () => switchTab('async'));

      // Sync name between live and async, persist in localStorage
      const savedName = localStorage.getItem('planningPokerName');
      if (savedName) {
        document.getElementById('asyncUserName').value = savedName;
        document.getElementById('userName').value = savedName;
      }
      document.getElementById('asyncUserName').addEventListener('input', (e) => {
        localStorage.setItem('planningPokerName', e.target.value.trim());
        document.getElementById('userName').value = e.target.value;
      });
      document.getElementById('userName').addEventListener('input', (e) => {
        localStorage.setItem('planningPokerName', e.target.value.trim());
        document.getElementById('asyncUserName').value = e.target.value;
      });

      // Async sprint/ticket loading
      document.getElementById('asyncFetchSprintBtn').addEventListener('click', async () => {
        const sprintName = document.getElementById('asyncSprintName').value.trim();
        const btn = document.getElementById('asyncFetchSprintBtn');
        if (!sprintName) { alert('Please enter a sprint name'); return; }
        btn.disabled = true; btn.textContent = 'Loading...';
        try {
          const response = await fetch('/estimations/async_fetch_sprint_tickets', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken },
            body: JSON.stringify({ sprint_name: sprintName })
          });
          const result = await response.json();
          if (!response.ok) throw new Error(result.error || 'Failed to fetch sprint');
          if (result.state) syncState(result.state, 'async_tickets_loaded');
          asyncCurrentIndex = 0;
          renderAsyncAll();
          showStatus(result.message);
        } catch (error) {
          showStatus(error.message, true);
        } finally {
          btn.disabled = false; btn.textContent = 'Load Sprint';
        }
      });

      document.getElementById('asyncFetchJiraBtn').addEventListener('click', async () => {
        const jiraInput = document.getElementById('asyncJiraTicket').value.trim();
        const btn = document.getElementById('asyncFetchJiraBtn');
        if (!jiraInput) { alert('Please enter a JIRA ticket key or URL'); return; }
        btn.disabled = true; btn.textContent = 'Fetching...';
        try {
          const response = await fetch('/estimations/async_fetch_jira_ticket', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken },
            body: JSON.stringify({ jira_input: jiraInput })
          });
          const result = await response.json();
          if (!response.ok) throw new Error(result.error || 'Failed to fetch ticket');
          if (result.state) syncState(result.state, 'async_ticket_added');
          asyncCurrentIndex = state.asyncTickets.length - 1;
          renderAsyncAll();
          document.getElementById('asyncJiraTicket').value = '';
          showStatus(result.message);
        } catch (error) {
          showStatus(error.message, true);
        } finally {
          btn.disabled = false; btn.textContent = 'Fetch Ticket';
        }
      });

      // Async navigation
      document.getElementById('asyncPrevTicketBtn').addEventListener('click', () => {
        if (asyncCurrentIndex > 0) asyncNavigate(asyncCurrentIndex - 1);
      });
      document.getElementById('asyncNextTicketBtn').addEventListener('click', () => {
        if (asyncCurrentIndex < state.asyncTickets.length - 1) asyncNavigate(asyncCurrentIndex + 1);
      });

      // Async vote/reveal/clear
      document.getElementById('asyncSubmitBtn').addEventListener('click', () => asyncVote());
      document.getElementById('asyncRevealBtn').addEventListener('click', () => asyncReveal());
      document.getElementById('asyncClearBtn').addEventListener('click', () => asyncClear());

      // Initialize WebSocket connection
      setupSubscription();
      
      // Initial render
      renderAll();
      
      console.log("[Init] Application initialized successfully");
    }

    function pauseTimers() {
      if (heartbeatInterval) clearInterval(heartbeatInterval);
      if (stateValidationInterval) clearInterval(stateValidationInterval);
      if (healthCheckInterval) clearInterval(healthCheckInterval);
    }

    function resumeTimers() {
      if (state.isConnected) {
        startHeartbeat();
        startStateValidation();
        startHealthChecks();
      }
    }

    function cleanup() {
      // Clear all timers
      if (heartbeatInterval) clearInterval(heartbeatInterval);
      if (reconnectTimeout) clearTimeout(reconnectTimeout);
      if (stateValidationInterval) clearInterval(stateValidationInterval);
      if (healthCheckInterval) clearInterval(healthCheckInterval);
      
      // Unsubscribe from WebSocket
      if (subscription) {
        subscription.unsubscribe();
      }
      
      console.log("[Cleanup] Cleanup completed");
    }

    // Add image click handlers for expansion
    function addImageClickHandlers() {
      // Add click handlers to all JIRA images
      document.querySelectorAll('.jira-image').forEach(img => {
        img.addEventListener('click', function() {
          openImageModal(this.src, this.alt);
        });
      });
    }

    // Format file size for display
    function formatFileSize(bytes) {
      if (!bytes) return '';
      const sizes = ['B', 'KB', 'MB', 'GB'];
      const i = Math.floor(Math.log(bytes) / Math.log(1024));
      return Math.round(bytes / Math.pow(1024, i) * 100) / 100 + ' ' + sizes[i];
    }

    function openImageModal(src, alt) {
      // Create modal overlay
      const modal = document.createElement('div');
      modal.style.cssText = `
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0,0,0,0.8);
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 10000;
        cursor: pointer;
      `;
      
      // Create image
      const img = document.createElement('img');
      img.src = src;
      img.alt = alt;
      img.style.cssText = `
        max-width: 90%;
        max-height: 90%;
        border-radius: 8px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.5);
      `;
      
      // Create close button
      const closeBtn = document.createElement('div');
      closeBtn.innerHTML = '×';
      closeBtn.style.cssText = `
        position: absolute;
        top: 20px;
        right: 30px;
        color: white;
        font-size: 40px;
        font-weight: bold;
        cursor: pointer;
        z-index: 10001;
      `;
      
      modal.appendChild(img);
      modal.appendChild(closeBtn);
      document.body.appendChild(modal);
      
      // Close modal on click
      modal.addEventListener('click', function() {
        document.body.removeChild(modal);
      });
      
      // Prevent image click from closing modal
      img.addEventListener('click', function(e) {
        e.stopPropagation();
      });
    }

    // Start the application
    init();
    
    // Add image handlers after initial render
    setTimeout(addImageClickHandlers, 1000);
  </script>
</body>
</html>