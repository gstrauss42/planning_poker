    </div>

    <div class="controls">
      <button id="asyncRevealBtn" class="reveal" disabled>Reveal</button>
      <button id="asyncClearBtn" class="clear" disabled>Clear Votes</button>
    </div>

    <div class="participants">
      <h2>
        Participants
        <span class="presence-badge" id="asyncVoteBadge">0 voted</span>
      </h2>
      <div id="asyncParticipantsList"></div>
    </div>
  </div>

  <script type="module">
    import { createConsumer } from "@rails/actioncable"
    
    // Enhanced global state object with validation
    const state = {
      votes: {},
      revealed: false,
      ticketData: null,
      ticketId: null,
      tickets: [],
      currentTicketIndex: 0,
      votesByTicket: {},
      revealedByTicket: {},
      asyncTickets: [],
      asyncVotesByTicket: {},
      asyncRevealedByTicket: {},
      connectedCount: 0,
      votedCount: 0,
      version: 0,
      lastUpdated: 0,
      sessionHealth: 100,
      connectionId: null,
      isConnected: false,
      lastHeartbeat: 0,
      reconnectAttempts: 0,
      maxReconnectAttempts: 10,
      pendingOperations: new Set()
    };
    
    let currentMode = 'live';
    let asyncCurrentIndex = 0;

    let subscription = null;
    let heartbeatInterval = null;
    let reconnectTimeout = null;
    let stateValidationInterval = null;
    let healthCheckInterval = null;
    
    const csrfToken = document.querySelector('meta[name="csrf-token"]').content;
    
    // Enhanced connection status management
    function updateConnectionStatus(connected, text = null) {
      state.isConnected = connected;
      
      if (connected) {
        state.reconnectAttempts = 0; // Reset on successful connection
      }
    }

    function showStatus(message, isError = false, duration = 3000) {
      console.log(`[Status] ${message}`);
      const indicator = document.getElementById("statusIndicator");
      indicator.textContent = message;
      indicator.classList.add("show");
      if (isError) {
        indicator.classList.add("error");
      } else {
        indicator.classList.remove("error");
      }
      setTimeout(() => {
        indicator.classList.remove("show");
        indicator.classList.remove("error");
      }, duration);
    }

    function escapeHtml(text) {
      const div = document.createElement('div');
      div.textContent = text;
      return div.innerHTML;
    }

    // Enhanced state validation and sync
    function validateStateIntegrity(serverState) {
      const issues = [];
      
      if (serverState.version < 0) {
        issues.push("Invalid version number");
      }
      
      if (serverState.votes && typeof serverState.votes !== 'object') {
        issues.push("Invalid votes structure");
      }
      
      if (serverState.revealed && (!serverState.votes || Object.keys(serverState.votes).length === 0)) {
        issues.push("Revealed state without votes");
      }
      
      if (serverState.connected_count < 0) {
        issues.push("Invalid connection count");
      }
      
      return issues;
    }
    
    function syncState(serverState, changeAction = null) {
      console.log(`[Sync] Updating to version ${serverState.version} from ${state.version}, action: ${changeAction}`);
      console.log(`[Sync] Server state:`, serverState);
      
      // Prevent infinite loops - track sync attempts
      if (!state.syncAttempts) state.syncAttempts = 0;
      state.syncAttempts++;
      
      if (state.syncAttempts > 5) {
        console.error(`[Sync] Too many sync attempts (${state.syncAttempts}), stopping to prevent loop`);
        showStatus("Sync loop detected. Please refresh the page.", true, 10000);
        return;
      }
      
      // Validate server state before applying
      const validationIssues = validateStateIntegrity(serverState);
      if (validationIssues.length > 0) {
        console.error(`[Sync] State validation failed: ${validationIssues.join(', ')}`);
        showStatus("State validation failed. Requesting fresh state...", true);
        setTimeout(() => requestStateSync(), 1000); // Add delay to prevent rapid loops
        return;
      }
      
      // Check for version conflicts
      if (state.version > 0 && serverState.version < state.version) {
        console.warn(`[Sync] Version regression detected: server ${serverState.version} < client ${state.version}`);
        showStatus("Version conflict detected. Refreshing state...", true);
        setTimeout(() => requestStateSync(), 1000); // Add delay to prevent rapid loops
        return;
      }
      
      // Reset sync attempts and request count on successful sync
      state.syncAttempts = 0;
      state.syncRequestCount = 0;
      
      // Store previous state for rollback
      const previousState = { ...state };
      
      try {
        // Update all state properties
        state.votes = serverState.votes || {};
        state.revealed = serverState.revealed || false;
        state.ticketData = serverState.ticket_data || null;
        state.ticketId = serverState.ticket_id || null;
        state.tickets = serverState.tickets || [];
        state.currentTicketIndex = serverState.current_ticket_index || 0;
        state.votesByTicket = serverState.votes_by_ticket || {};
        state.revealedByTicket = serverState.revealed_by_ticket || {};
        state.asyncTickets = serverState.async_tickets || [];
        state.asyncVotesByTicket = serverState.async_votes_by_ticket || {};
        state.asyncRevealedByTicket = serverState.async_revealed_by_ticket || {};
        state.connectedCount = serverState.connected_count || 0;
        state.votedCount = serverState.voted_count || 0;
        state.version = serverState.version || 0;
        state.lastUpdated = serverState.last_updated || Date.now();
        state.sessionHealth = serverState.session_health || 100;

        console.log(`[Sync] Updated client state:`, state);

        // Update UI
        renderAll();

        // Show appropriate status message
        if (changeAction && state.version > 0) {
          showStatusForAction(changeAction);
        }

        console.log(`[Sync] State updated successfully to version ${state.version}`);

      } catch (error) {
        console.error(`[Sync] Error updating state: ${error.message}`);
        // Rollback to previous state
        Object.assign(state, previousState);
        renderAll();
        showStatus("State update failed. Please refresh.", true);
      }
    }

    function showStatusForAction(action) {
      switch (action) {
        case 'ticket_set':
          showStatus("Ticket loaded");
          break;
        case 'tickets_loaded':
          showStatus(`${state.tickets.length} tickets loaded from sprint`);
          break;
        case 'ticket_changed':
          showStatus("Navigated to ticket");
          break;
        case 'vote_added':
          showStatus("Vote recorded");
          break;
        case 'votes_revealed':
          showStatus("Votes revealed!");
          break;
        case 'votes_cleared':
          showStatus("Votes cleared");
          break;
        case 'ticket_removed':
          showStatus("Ticket removed");
          break;
        case 'tickets_cleared':
          showStatus("Tickets cleared");
          break;
        case 'async_ticket_removed':
          showStatus("Ticket removed");
          break;
        case 'async_tickets_cleared':
          showStatus("Async tickets cleared");
          break;
        case 'async_tickets_loaded':
          showStatus(`${state.asyncTickets.length} async tickets loaded`);
          break;
        case 'async_ticket_added':
          showStatus("Ticket added for async voting");
          break;
        case 'async_vote_added':
          showStatus("Vote recorded");
          break;
        case 'async_votes_revealed':
          showStatus("Votes revealed");
          break;
        case 'async_votes_cleared':
          showStatus("Votes cleared");
          break;
        default:
          showStatus("Session updated");
      }
    }

    function updatePresenceBadge() {
      const badge = document.getElementById("presenceBadge");
      badge.textContent = `${state.votedCount}/${state.connectedCount} voted`;
      
      if (state.connectedCount > 0 && state.votedCount === state.connectedCount) {
        badge.classList.add("all-voted");
      } else {
        badge.classList.remove("all-voted");
      }
    }

    function renderTicket() {
      const display = document.getElementById("ticketDisplay");
      const html = generateTicketHtml(state.ticketData, '');
      if (!html) {
        display.innerHTML = '<span>No ticket loaded - Load sprint or enter a JIRA ticket to begin</span>';
        display.classList.add("empty");
        return;
      }
      display.classList.remove("empty");
      const wasExpanded = document.getElementById('TechnicalWriteupContent')?.classList.contains('expanded');
      display.innerHTML = html;
      if (wasExpanded) {
        document.getElementById('TechnicalWriteupContent')?.classList.add('expanded');
        document.getElementById('TechCollapseIcon')?.classList.add('expanded');
      }
      setTimeout(addImageClickHandlers, 100);
      if (typeof Prism !== 'undefined') Prism.highlightAll();
    }

    window.toggleTechnicalWriteup = function() {
      toggleWriteup('');
    };

    function renderVotes() {
      const list = document.getElementById("participantsList");
      const revealBtn = document.getElementById("revealBtn");
      const clearBtn = document.getElementById("clearBtn");
      const hasVotes = state.votes && Object.keys(state.votes).length > 0;
      
      // Enable/disable buttons based on vote state
      // Only disable when no votes - don't disable based on revealed state
      // (someone could vote after reveal, and we should be able to reveal again)
      revealBtn.disabled = !hasVotes;
      clearBtn.disabled = !hasVotes;
      
      if (!hasVotes) {
        list.innerHTML = '<div class="empty-state">No votes yet</div>';
        return;
      }

      let html = Object.entries(state.votes)
        .map(([name, points]) => `
          <div class="participant">
            <span class="participant-name">${escapeHtml(name)}</span>
            ${state.revealed ? 
              `<span class="points">${escapeHtml(points)}</span>` : 
              `<span class="participant-status">✓ Voted</span>`
            }
          </div>
        `)
        .join('');

      // Add vote distribution summary when votes are revealed
      if (state.revealed) {
        const voteDistribution = getVoteDistribution();
        if (voteDistribution.length > 0) {
          html += `
            <div class="vote-distribution">
              <div class="distribution-header">Vote Distribution</div>
              <div class="distribution-items">
                ${(() => {
                  const maxCount = Math.max(...voteDistribution.map(d => d.count));
                  const hasMultipleVotes = voteDistribution.length > 1;
                  return voteDistribution.map(({value, count}) => {
                    const isWinner = hasMultipleVotes && count === maxCount;
                    return `
                      <div class="distribution-item${isWinner ? ' winner' : ''}">
                        <span class="distribution-value">${escapeHtml(value)}</span>
                        <span class="distribution-separator">→</span>
                        <span class="distribution-count">${count} ${count === 1 ? 'vote' : 'votes'}${isWinner ? '<span class="winner-badge">🏆</span>' : ''}</span>
                      </div>
                    `;
                  }).join('');
                })()}
              </div>
            </div>
          `;
        }
      }

      list.innerHTML = html;
    }

    function getVoteDistribution(votesOverride) {
      const votes = votesOverride || state.votes;
      if (!votes || Object.keys(votes).length === 0) {
        return [];
      }

      const voteCounts = {};
      Object.values(votes).forEach(points => {
        voteCounts[points] = (voteCounts[points] || 0) + 1;
      });

      // Convert to array and sort by vote value (numeric first, then ?)
      return Object.entries(voteCounts)
        .map(([value, count]) => ({ value, count }))
        .sort((a, b) => {
          // Sort ? last, otherwise sort numerically
          if (a.value === '?') return 1;
          if (b.value === '?') return -1;
          return parseInt(a.value) - parseInt(b.value);
        });
    }

    // --- Async mode ---

    function switchTab(mode) {
      currentMode = mode;
      document.getElementById('liveTab').classList.toggle('active', mode === 'live');
      document.getElementById('asyncTab').classList.toggle('active', mode === 'async');
      document.getElementById('liveContent').style.display = mode === 'live' ? '' : 'none';
      document.getElementById('asyncContent').style.display = mode === 'async' ? '' : 'none';
      if (mode === 'async') renderAsyncAll();
      renderTicketsSidebar();
    }

    function handleTicketClick(index, ticketKey) {
      if (currentMode === 'async') {
        asyncNavigate(index);
      } else {
        navigateToTicketByIndex(index);
      }
    }

    function getAsyncCurrentTicket() {
      if (!state.asyncTickets || state.asyncTickets.length === 0) return null;
      if (asyncCurrentIndex < 0 || asyncCurrentIndex >= state.asyncTickets.length) return null;
      return state.asyncTickets[asyncCurrentIndex];
    }

    function getAsyncCurrentVotes() {
      const ticket = getAsyncCurrentTicket();
      if (!ticket) return {};
      return state.asyncVotesByTicket[ticket.key] || {};
    }

    function getAsyncCurrentRevealed() {
      const ticket = getAsyncCurrentTicket();
      if (!ticket) return false;
      return state.asyncRevealedByTicket[ticket.key] || false;
    }

    function asyncNavigate(index) {
      if (index < 0 || index >= state.asyncTickets.length) return;
      asyncCurrentIndex = index;
      renderAsyncAll();
      renderTicketsSidebar();
    }

    function generateTicketHtml(ticketData, prefix) {
      if (!ticketData) return null;
      const p = prefix || '';

      let html = `
        <div class="ticket-header">
          <div>
            <div class="ticket-title">${escapeHtml(ticketData.formatted_title || ticketData.key)}</div>
            <div class="ticket-meta">
              ${ticketData.status ? `<div class="ticket-meta-item"><span class="ticket-meta-label">Status:</span><span>${escapeHtml(ticketData.status)}</span></div>` : ''}
              ${ticketData.priority ? `<div class="ticket-meta-item"><span class="ticket-meta-label">Priority:</span><span>${escapeHtml(ticketData.priority)}</span></div>` : ''}
              ${ticketData.assignee ? `<div class="ticket-meta-item"><span class="ticket-meta-label">Assignee:</span><span>${escapeHtml(ticketData.assignee)}</span></div>` : ''}
            </div>
          </div>
        </div>
        <div class="ticket-content">`;

      if (ticketData.description && ticketData.description.trim()) {
        html += `<div class="ticket-section-block"><div class="section-header">Description</div><div class="section-content">${ticketData.description}</div></div>`;
      }
      if (ticketData.acceptance_criteria && ticketData.acceptance_criteria.trim()) {
        html += `<div class="ticket-section-block"><div class="section-header">Acceptance Criteria</div><div class="section-content">${ticketData.acceptance_criteria}</div></div>`;
      }
      if (ticketData.technical_writeup && ticketData.technical_writeup.trim()) {
        html += `
          <div class="ticket-section-block">
            <div class="collapsible-section">
              <div class="collapsible-header" onclick="toggleWriteup('${p}')">
                <div class="section-header">Technical Writeup</div>
                <span class="collapse-icon" id="${p}TechCollapseIcon">▼</span>
              </div>
              <div class="collapsible-content" id="${p}TechnicalWriteupContent">
                <div class="section-content">${ticketData.technical_writeup}</div>
              </div>
            </div>
          </div>`;
      }
      if (ticketData.attachments && ticketData.attachments.length > 0) {
        html += `<div class="ticket-section-block"><div class="section-header">Attachments</div><div class="section-content"><div class="attachments-list">`;
        ticketData.attachments.forEach(att => {
          const sizeText = att.size ? `(${formatFileSize(att.size)})` : '';
          const icon = att.is_image ? '🖼️' : '📎';
          const url = att.proxy_url || att.url;
          html += `<div class="jira-attachment"><a href="${url}" target="_blank" class="attachment-link">${icon} ${escapeHtml(att.filename)} ${sizeText}</a></div>`;
        });
        html += `</div></div></div>`;
      }
      html += '</div>';
      return html;
    }

    window.toggleWriteup = function(prefix) {
      const p = prefix || '';
      const content = document.getElementById(p + 'TechnicalWriteupContent');
      const icon = document.getElementById(p + 'TechCollapseIcon');
      if (content && icon) {
        content.classList.toggle('expanded');
        icon.classList.toggle('expanded');
      }
    };

    function renderAsyncTicket() {
      const display = document.getElementById('asyncTicketDisplay');
      const ticket = getAsyncCurrentTicket();
      const html = generateTicketHtml(ticket, 'async');
      if (!html) {
        display.innerHTML = '<span>No ticket loaded - Load sprint or enter a JIRA ticket to begin</span>';
        display.classList.add('empty');
        return;
      }
      display.classList.remove('empty');
      const wasExpanded = document.getElementById('asyncTechnicalWriteupContent')?.classList.contains('expanded');
      display.innerHTML = html;
      if (wasExpanded) {
        document.getElementById('asyncTechnicalWriteupContent')?.classList.add('expanded');
        document.getElementById('asyncTechCollapseIcon')?.classList.add('expanded');
      }
      setTimeout(addImageClickHandlers, 100);
      if (typeof Prism !== 'undefined') Prism.highlightAll();
    }

    function renderAsyncVotes() {
      const list = document.getElementById('asyncParticipantsList');
      const revealBtn = document.getElementById('asyncRevealBtn');
      const clearBtn = document.getElementById('asyncClearBtn');
      const badge = document.getElementById('asyncVoteBadge');
      const votes = getAsyncCurrentVotes();
      const revealed = getAsyncCurrentRevealed();
      const hasVotes = Object.keys(votes).length > 0;

      revealBtn.disabled = !hasVotes;
      clearBtn.disabled = !hasVotes;
      badge.textContent = `${Object.keys(votes).length} voted`;

      if (!hasVotes) {
        list.innerHTML = '<div class="empty-state">No votes yet</div>';
        return;
      }

      let html = Object.entries(votes)
        .map(([name, points]) => `
          <div class="participant">
            <span class="participant-name">${escapeHtml(name)}</span>
            ${revealed
              ? `<span class="points">${escapeHtml(points)}</span>`
              : `<span class="participant-status">✓ Voted</span>`}
          </div>`).join('');

      if (revealed) {
        const dist = getVoteDistribution(votes);
        if (dist.length > 0) {
          const maxCount = Math.max(...dist.map(d => d.count));
          const hasMultiple = dist.length > 1;
          html += `
            <div class="vote-distribution">
              <div class="distribution-header">Vote Distribution</div>
              <div class="distribution-items">
                ${dist.map(({value, count}) => {
                  const isWinner = hasMultiple && count === maxCount;
                  return `
                    <div class="distribution-item${isWinner ? ' winner' : ''}">
