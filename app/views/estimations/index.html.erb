<!DOCTYPE html>
<html>
<head>
  <title>Planning Poker</title>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= javascript_importmap_tags %>
  <!-- Prism.js for syntax highlighting -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/themes/prism-tomorrow.min.css" />
  <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/prism.min.js"></script>
  <!-- Common language support -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/components/prism-ruby.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/components/prism-python.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/components/prism-javascript.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/components/prism-typescript.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/components/prism-java.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/components/prism-json.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/components/prism-bash.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/components/prism-sql.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/components/prism-yaml.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/components/prism-markup.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/components/prism-css.min.js"></script>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background: #f5f5f5;
      padding: 20px;
    }
    .container {
      max-width: 1000px;
      margin: 0 auto;
      background: white;
      padding: 40px;
      border-radius: 8px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }
    h1 {
      margin: 0 0 30px 0;
      color: #333;
    }
    .presence-badge {
      font-size: 16px;
      font-weight: 500;
      color: #2196F3;
      background: #e3f2fd;
      padding: 8px 16px;
      border-radius: 20px;
      border: 2px solid #2196F3;
      transition: all 0.3s ease;
    }
    .presence-badge.all-voted {
      color: #4CAF50;
      background: #e8f5e9;
      border-color: #4CAF50;
    }
    .ticket-section {
      margin-bottom: 30px;
      padding-bottom: 20px;
      border-bottom: 2px solid #eee;
    }
    .jira-input-group {
      display: flex;
      gap: 10px;
      margin-bottom: 20px;
    }
    .ticket-display {
      background: #e3f2fd;
      border-radius: 8px;
      padding: 20px;
      margin-top: 15px;
      min-height: 100px;
    }
    .ticket-display.empty {
      text-align: center;
      color: #999;
      font-style: italic;
      padding: 40px;
    }
    .ticket-header {
      display: flex;
      justify-content: space-between;
      align-items: start;
      margin-bottom: 20px;
      padding-bottom: 15px;
      border-bottom: 2px solid #2196F3;
    }
    .ticket-title {
      font-size: 24px;
      font-weight: 600;
      color: #2196F3;
      flex: 1;
    }
    .ticket-meta {
      display: flex;
      gap: 20px;
      font-size: 14px;
      color: #666;
      margin-top: 8px;
    }
    .ticket-meta-item {
      display: flex;
      align-items: center;
      gap: 5px;
    }
    .ticket-meta-label {
      font-weight: 600;
    }
    .ticket-content {
      margin-top: 20px;
    }
    .ticket-section-block {
      margin-bottom: 25px;
    }
    .section-header {
      font-size: 16px;
      font-weight: 600;
      color: #333;
      margin-bottom: 10px;
      padding-bottom: 5px;
      border-bottom: 1px solid #ddd;
    }
    .section-content {
      color: #555;
      line-height: 1.6;
      font-size: 15px;
    }
    .section-content h1, .section-content h2, .section-content h3 {
      margin-top: 16px;
      margin-bottom: 8px;
      font-weight: 600;
      color: #333;
    }
    .section-content p {
      margin-bottom: 12px;
    }
    .section-content ul, .section-content ol {
      margin: 12px 0;
      padding-left: 28px;
    }
    .section-content code {
      background: #f5f5f5;
      padding: 2px 6px;
      border-radius: 3px;
      font-family: 'Fira Code', 'Consolas', 'Monaco', monospace;
      font-size: 13px;
    }
    .section-content pre {
      border-radius: 6px;
      overflow-x: auto;
      margin: 12px 0;
    }
    .section-content pre[class*="language-"] {
      margin: 12px 0;
      border-radius: 6px;
    }
    .section-content pre code {
      background: none;
      padding: 0;
      font-family: 'Fira Code', 'Consolas', 'Monaco', monospace;
      font-size: 13px;
      line-height: 1.5;
    }
    .section-content blockquote {
      border-left: 4px solid #ddd;
      padding-left: 16px;
      margin: 12px 0;
      color: #666;
      font-style: italic;
    }
    .section-content strong {
      font-weight: 600;
    }
    .section-content em {
      font-style: italic;
    }
    .section-content hr {
      border: none;
      border-top: 1px solid #ddd;
      margin: 16px 0;
    }
    /* ADF Table Styles */
    .section-content .adf-table-wrapper {
      overflow-x: auto;
      margin: 16px 0;
      max-width: 100%;
    }
    .section-content .adf-table {
      min-width: 100%;
      border-collapse: collapse;
      font-size: 14px;
    }
    .section-content .adf-table th,
    .section-content .adf-table td {
      border: 1px solid #ddd;
      padding: 10px 12px;
      text-align: left;
      vertical-align: top;
    }
    .section-content .adf-table th {
      background: #f5f5f5;
      font-weight: 600;
      color: #333;
    }
    .section-content .adf-table tr:nth-child(even) td {
      background: #fafafa;
    }
    .section-content .adf-table tr:hover td {
      background: #f0f7ff;
    }
    /* ADF Panel Styles */
    .section-content .adf-panel {
      padding: 12px 16px;
      margin: 12px 0;
      border-radius: 4px;
      border-left: 4px solid;
    }
    .section-content .adf-panel p:last-child {
      margin-bottom: 0;
    }
    .section-content .adf-panel-header {
      display: flex;
      align-items: center;
      gap: 6px;
      font-weight: 600;
      margin-bottom: 8px;
      font-size: 14px;
    }
    .section-content .adf-panel-icon {
      font-size: 16px;
    }
    .section-content .adf-panel-info {
      background: #e3f2fd;
      border-left-color: #2196F3;
    }
    .section-content .adf-panel-info .adf-panel-header {
      color: #1565c0;
    }
    .section-content .adf-panel-note {
      background: #f3e5f5;
      border-left-color: #9c27b0;
    }
    .section-content .adf-panel-note .adf-panel-header {
      color: #7b1fa2;
    }
    .section-content .adf-panel-warning {
      background: #fff3e0;
      border-left-color: #ff9800;
    }
    .section-content .adf-panel-warning .adf-panel-header {
      color: #e65100;
    }
    .section-content .adf-panel-error {
      background: #ffebee;
      border-left-color: #f44336;
    }
    .section-content .adf-panel-error .adf-panel-header {
      color: #c62828;
    }
    .section-content .adf-panel-success {
      background: #e8f5e9;
      border-left-color: #4CAF50;
    }
    .section-content .adf-panel-success .adf-panel-header {
      color: #2e7d32;
    }
    /* ADF Mention Styles */
    .section-content .adf-mention {
      background: #e3f2fd;
      color: #1565c0;
      padding: 2px 6px;
      border-radius: 3px;
      font-weight: 500;
    }
    /* ADF Status Badge Styles */
    .section-content .adf-status {
      display: inline-block;
      padding: 2px 8px;
      border-radius: 3px;
      font-size: 12px;
      font-weight: 600;
      text-transform: uppercase;
    }
    .section-content .adf-status-neutral {
      background: #e0e0e0;
      color: #616161;
    }
    .section-content .adf-status-blue {
      background: #e3f2fd;
      color: #1565c0;
    }
    .section-content .adf-status-green {
      background: #e8f5e9;
      color: #2e7d32;
    }
    .section-content .adf-status-yellow {
      background: #fff8e1;
      color: #f57f17;
    }
    .section-content .adf-status-red {
      background: #ffebee;
      color: #c62828;
    }
    .section-content .adf-status-purple {
      background: #f3e5f5;
      color: #7b1fa2;
    }
    /* ADF Date Styles */
    .section-content .adf-date {
      background: #f5f5f5;
      padding: 2px 6px;
      border-radius: 3px;
      font-size: 13px;
      color: #666;
    }
    /* ADF Expand/Collapse Styles */
    .section-content .adf-expand {
      border: 1px solid #ddd;
      border-radius: 4px;
      margin: 12px 0;
    }
    .section-content .adf-expand summary {
      padding: 10px 14px;
      background: #f9f9f9;
      cursor: pointer;
      font-weight: 500;
      user-select: none;
    }
    .section-content .adf-expand summary:hover {
      background: #f0f0f0;
    }
    .section-content .adf-expand[open] summary {
      border-bottom: 1px solid #ddd;
    }
    .section-content .adf-expand > *:not(summary) {
      padding: 12px 14px;
    }
    /* ADF Media Styles */
    .section-content .adf-media {
      margin: 12px 0;
    }
    .section-content .adf-media-placeholder {
      background: #f5f5f5;
      border: 2px dashed #ddd;
      border-radius: 4px;
      padding: 20px;
      text-align: center;
      color: #999;
      font-style: italic;
    }
    /* ADF Inline Card (Smart Link) Styles */
    .section-content .adf-inline-card {
      background: #f5f5f5;
      padding: 2px 8px;
      border-radius: 3px;
      text-decoration: none;
      color: #1565c0;
      font-size: 13px;
      word-break: break-all;
    }
    .section-content .adf-inline-card:hover {
      background: #e3f2fd;
      text-decoration: underline;
    }
    .collapsible-section {
      border: 1px solid #ddd;
      border-radius: 6px;
      overflow: hidden;
    }
    .collapsible-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 12px 15px;
      background: #f9f9f9;
      cursor: pointer;
      user-select: none;
    }
    .collapse-icon {
      font-size: 18px;
      color: #666;
      transition: transform 0.3s;
    }
    .collapse-icon.expanded {
      transform: rotate(180deg);
    }
    .collapsible-content {
      padding: 15px;
      background: white;
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.3s ease-out;
    }
    .collapsible-content.expanded {
      max-height: 10000px;
      overflow-y: auto;
      transition: max-height 0.5s ease-in;
    }
    .input-section {
      display: flex;
      gap: 10px;
      margin-bottom: 20px;
      flex-wrap: wrap;
    }
    input, select, button {
      padding: 12px 16px;
      border: 1px solid #ddd;
      border-radius: 4px;
      font-size: 16px;
      font-family: inherit;
    }
    input {
      flex: 1;
      min-width: 150px;
    }
    select {
      min-width: 120px;
      background: white;
      cursor: pointer;
    }
    button {
      background: #4CAF50;
      color: white;
      border: none;
      cursor: pointer;
      font-weight: 500;
      transition: background 0.2s;
    }
    button:hover:not(:disabled) {
      background: #45a049;
    }
    button:disabled {
      background: #ccc;
      cursor: not-allowed;
    }
    .controls {
      display: flex;
      gap: 10px;
      margin-bottom: 30px;
    }
    .controls button {
      flex: 1;
    }
    button.reveal,
    button.clear {
      position: relative;
      overflow: hidden;
    }
    button.reveal::before,
    button.clear::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      height: 100%;
      width: 0%;
      background: rgba(255, 255, 255, 0.3);
      transition: none;
      pointer-events: none;
    }
    button.reveal.holding::before,
    button.clear.holding::before {
      width: 100%;
      transition: width 0.75s linear;
    }
    button.reveal {
      background: #2196F3;
    }
    button.reveal:hover:not(:disabled) {
      background: #0b7dda;
    }
    button.reveal:disabled {
      background: #90caf9;
      cursor: not-allowed;
      opacity: 0.6;
    }
    button.reveal:disabled::before,
    button.clear:disabled::before {
      display: none;
    }
    button.clear {
      background: #f44336;
    }
    button.clear:hover:not(:disabled) {
      background: #da190b;
    }
    button.clear:disabled {
      background: #ef9a9a;
      cursor: not-allowed;
      opacity: 0.6;
    }
    button.fetch-jira {
      background: #0052CC;
      min-width: 140px;
    }
    button.fetch-jira:hover:not(:disabled) {
      background: #0747A6;
    }
    .participants {
      margin-top: 20px;
      min-height: 100px;
    }
    .participants h2 {
      font-size: 18px;
      color: #666;
      margin-bottom: 15px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .participant {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 12px 16px;
      margin: 8px 0;
      background: #f9f9f9;
      border-radius: 4px;
      border-left: 4px solid #4CAF50;
    }
    .participant-name {
      font-weight: 500;
      color: #333;
    }
    .participant-status {
      color: #4CAF50;
      font-size: 14px;
    }
    .points {
      background: #4CAF50;
      color: white;
      padding: 6px 16px;
      border-radius: 16px;
      font-weight: bold;
      font-size: 16px;
    }
    .empty-state {
      text-align: center;
      padding: 40px;
      color: #999;
    }
    .vote-distribution {
      margin-top: 20px;
      padding: 15px;
      background: #f8f9fa;
      border-radius: 6px;
      border: 1px solid #e9ecef;
    }
    .distribution-header {
      font-size: 14px;
      font-weight: 600;
      color: #495057;
      margin-bottom: 10px;
      text-align: center;
    }
    .distribution-items {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      justify-content: center;
    }
    .distribution-item {
      display: flex;
      align-items: center;
      gap: 6px;
      padding: 8px 14px;
      background: white;
      border-radius: 20px;
      border: 1px solid #dee2e6;
      font-size: 14px;
      transition: all 0.2s ease;
    }
    .distribution-item.winner {
      background: #e8f5e9;
      border-color: #4CAF50;
      box-shadow: 0 2px 8px rgba(76, 175, 80, 0.3);
    }
    .distribution-value {
      font-weight: 700;
      font-size: 18px;
      color: #2196F3;
      min-width: 24px;
      text-align: center;
    }
    .distribution-item.winner .distribution-value {
      color: #2e7d32;
    }
    .distribution-separator {
      color: #aaa;
      font-size: 12px;
    }
    .distribution-item.winner .distribution-separator {
      color: #81c784;
    }
    .distribution-count {
      color: #666;
      font-size: 13px;
      font-weight: 500;
    }
    .distribution-item.winner .distribution-count {
      color: #2e7d32;
      font-weight: 600;
    }
    .winner-badge {
      font-size: 11px;
      margin-left: 4px;
    }
    .status-indicator {
      position: fixed;
      top: 20px;
      right: 20px;
      padding: 10px 20px;
      background: #4CAF50;
      color: white;
      border-radius: 20px;
      font-size: 14px;
      opacity: 0;
      transition: opacity 0.3s;
      pointer-events: none;
      z-index: 1000;
    }
    .status-indicator.show {
      opacity: 1;
    }
    .status-indicator.error {
      background: #f44336;
    }
    
    /* JIRA Image Styles */
    .jira-image-container {
      margin: 15px 0;
      text-align: center;
      border: 1px solid #ddd;
      border-radius: 6px;
      padding: 10px;
      background: #f9f9f9;
    }
    
    .jira-image {
      max-width: 100%;
      height: auto;
      border-radius: 4px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.1);
      cursor: pointer;
      transition: transform 0.2s ease;
    }
    
    .jira-image:hover {
      transform: scale(1.02);
    }
    
    .jira-attachment, .jira-external-media {
      margin: 10px 0;
      padding: 8px 12px;
      background: #e3f2fd;
      border-left: 4px solid #2196F3;
      border-radius: 4px;
    }
    
    .attachment-link {
      color: #1976D2;
      text-decoration: none;
      font-weight: 500;
    }
    
    .attachment-link:hover {
      text-decoration: underline;
    }
    
    .media-group {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin: 15px 0;
    }

    .image-caption {
      font-size: 12px;
      color: #666;
      text-align: center;
      margin-top: 5px;
      word-break: break-word;
    }

    .attachments-list {
      margin-top: 10px;
    }

    .attachments-list .jira-attachment {
      margin: 5px 0;
    }
    
    .media-single {
      margin: 10px 0;
    }
    
    .jira-media-error, .jira-media-unknown {
      padding: 8px;
      background: #ffebee;
      border: 1px solid #f44336;
      border-radius: 4px;
      color: #c62828;
      font-style: italic;
    }
    /* Tickets Sidebar Styles */
    .tickets-sidebar {
      position: fixed;
      left: 0;
      top: 0;
      width: 320px;
      height: 100vh;
      background: white;
      border-right: 2px solid #ddd;
      display: flex;
      flex-direction: column;
      z-index: 100;
      box-shadow: 2px 0 8px rgba(0,0,0,0.1);
    }
    .sidebar-header {
      padding: 20px;
      border-bottom: 2px solid #2196F3;
      background: #e3f2fd;
    }
    .sidebar-header h3 {
      margin: 0 0 8px 0;
      color: #2196F3;
      font-size: 18px;
    }
    .tickets-count {
      font-size: 14px;
      color: #666;
      font-weight: 500;
    }
    .tickets-list-toolbar {
      position: sticky;
      top: 0;
      z-index: 1;
      display: flex;
      justify-content: flex-end;
      padding: 4px 2px 10px;
      margin-bottom: 4px;
      background: linear-gradient(to bottom, #fff 70%, rgba(255,255,255,0));
    }
    .clear-tickets-btn {
      background: transparent;
      border: 1px solid #ccc;
      color: #666;
      font-size: 11px;
      font-weight: 600;
      padding: 4px 10px;
      border-radius: 4px;
      cursor: pointer;
      transition: all 0.15s ease;
    }
    .clear-tickets-btn:hover {
      background: #ffebee;
      border-color: #c62828;
      color: #c62828;
    }
    .tickets-list {
      flex: 1;
      overflow-y: auto;
      padding: 10px;
    }
    .ticket-item {
      position: relative;
      padding: 12px;
      margin-bottom: 8px;
      background: #f9f9f9;
      border-radius: 6px;
      border-left: 4px solid #ddd;
      cursor: pointer;
      transition: all 0.2s ease;
    }
    .ticket-item-remove {
      position: absolute;
      top: 6px;
      right: 6px;
      width: 22px;
      height: 22px;
      display: flex;
      align-items: center;
      justify-content: center;
      border: none;
      border-radius: 50%;
      background: transparent;
      color: #aaa;
      font-size: 16px;
      line-height: 1;
      cursor: pointer;
      opacity: 0;
      transition: opacity 0.15s ease, background 0.15s ease, color 0.15s ease;
      padding: 0;
    }
    .ticket-item:hover .ticket-item-remove,
    .ticket-item.active .ticket-item-remove {
      opacity: 1;
    }
    .ticket-item-remove:hover {
      background: #ffebee;
      color: #c62828;
    }
    .ticket-item:hover {
      background: #f0f7ff;
      border-left-color: #2196F3;
      transform: translateX(4px);
    }
    .ticket-item.active {
      background: #e3f2fd;
      border-left-color: #2196F3;
      box-shadow: 0 2px 6px rgba(33, 150, 243, 0.3);
    }
    .ticket-item-key {
      font-weight: 600;
      color: #2196F3;
      font-size: 13px;
      margin-bottom: 4px;
      padding-right: 24px;
    }
    .ticket-item-summary {
      font-size: 13px;
      color: #555;
      line-height: 1.4;
      overflow: hidden;
      text-overflow: ellipsis;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
    }
    .ticket-item-status {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-top: 6px;
      font-size: 11px;
      color: #999;
    }
    .ticket-item-votes {
      background: #4CAF50;
      color: white;
      padding: 2px 8px;
      border-radius: 10px;
      font-size: 11px;
